# Postgres. Locally: `docker compose up -d --wait` (see docker-compose.yml).
# Deployed: Neon. The app connects through DATABASE_URL (Neon: the pooled
# string); migrations need a direct connection, so set DIRECT_DATABASE_URL to
# the same string without "-pooler" in the host. Locally, leave it unset.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/hill_bagger"

# Auth.js. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# A GitHub OAuth app (github.com/settings/developers). Its callback URL must be
# <site>/api/auth/callback/github, so local and production need separate apps.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# The only GitHub account allowed to sign in and record ascents: its numeric id
# (https://api.github.com/users/<username> → "id"). Unset, nobody can sign in.
OWNER_GITHUB_ID=""

# Ordnance Survey map tiles (OS Data Hub, osdatahub.os.uk): a project on the free
# OpenData plan, with the OS Maps API added. The key is visible in the browser, as
# with any map service. On the OpenData plan that costs nothing, because paid
# data requests simply fail; on the Premium plan a copied key could run up
# charges. Unset, the map shows summits without tiles.
OS_MAPS_API_KEY=""
